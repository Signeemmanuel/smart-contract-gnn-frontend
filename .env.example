# Base URL of the smart-contract-gnn-api backend.
# Defaults (in src/config.js) to the deployed Hugging Face Space, so the app
# works with no .env at all. Override for a local backend or your own Space.
VITE_API_BASE_URL=https://Signeemmanuel-smart-contract-gnn-api.hf.space

# Polling cadence and ceiling for the asynchronous analyse job (milliseconds).
# The ceiling sits above the server's 120s per-analysis timeout.
VITE_POLL_INTERVAL_MS=1000
VITE_POLL_TIMEOUT_MS=150000
